{
  "distance_influence": 120,

  "priority": [
    { "if": "!foot_access", "multiply_by": "0" },

    { "if": "foot_road_access == NO || foot_road_access == PRIVATE", "multiply_by": "0" },

    { "else": "", "multiply_by": "foot_priority" },

    { "if": "road_class == FOOTWAY || road_class == PEDESTRIAN", "multiply_by": 1.3 },
    { "if": "road_class == PATH", "multiply_by": 1.15 },
    { "if": "road_class == RESIDENTIAL", "multiply_by": 1.05 },

    { "if": "road_class == STEPS", "multiply_by": 0.4 },

    { "if": "road_class == PRIMARY || road_class == SECONDARY", "multiply_by": 0.5 },

    { "if": "road_environment == TUNNEL", "multiply_by": 0.6 },
    { "if": "road_environment == FERRY", "multiply_by": 0.5 },

    { "if": "surface == GRAVEL || surface == DIRT", "multiply_by": 0.85 }
  ],

  "speed": [
    { "if": "true", "limit_to": "foot_average_speed" },

    { "if": "road_class == STEPS", "limit_to": 2.5 },

    { "if": "surface == GRAVEL || surface == DIRT", "limit_to": 3.5 },

    { "if": "average_slope >= 15", "limit_to": 1.5 },
    { "else_if": "average_slope >= 7", "limit_to": 2.5 },
    { "else_if": "average_slope >= 4", "multiply_by": 0.85 },
    { "else_if": "average_slope <= -4", "multiply_by": 1.05 }
  ]
}
